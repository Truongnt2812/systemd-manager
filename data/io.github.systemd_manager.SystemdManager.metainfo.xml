<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.systemd_manager.SystemdManager</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <name>Systemd Manager</name>
  <summary>Start, stop, enable and inspect systemd services</summary>
  <developer id="io.github.truongnt2812">
    <name>Truong Nguyen</name>
  </developer>
  <description>
    <p>
      Systemd Manager is a desktop app for the services on your computer. It lists
      every system and user service, updates live when they change, and lets you
      control them without a terminal.
    </p>
    <ul>
      <li>Start, stop, restart, reload, enable, disable, mask and unmask services</li>
      <li>See why a service failed, with its exit code, CPU, memory and restarts</li>
      <li>Follow the journal live, pause it, search it, filter it by priority, boot or time, and save it</li>
      <li>Edit unit files with syntax highlighting; vendor units get a drop-in override that you can revert</li>
      <li>Create services from a form, optionally run on a schedule with a timer</li>
      <li>See all timers with their next and last run</li>
    </ul>
    <p>
      Changes to system services ask for your password through polkit.
    </p>
  </description>
